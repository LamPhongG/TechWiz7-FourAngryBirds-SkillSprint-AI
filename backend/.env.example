# Copy to backend/.env (ignored by git) and fill in real values.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Leave unset to use SQLite at backend/skillsprint.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://skillsprint:password@localhost:5432/skillsprint

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Leave empty to generate paths with the rule-based draft generator (no AI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when the model above is retired (404) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
GEMINI_TIMEOUT_S=120
# Modules generated in parallel; keep under your API key's requests-per-minute quota.
GENERATION_WORKERS=4
# Folder under app/genai_pipeline/prompts/
PROMPT_VERSION=v1.1

# Leave unset to store files in backend/uploads/
# UPLOAD_DIR=
MAX_UPLOAD_MB=20
ACCESS_TOKEN_MINUTES=480

# New-account emails (STARTTLS via Gmail SMTP).
# To enable real Gmail sending, generate a Google 16-character App Password (myaccount.google.com/security):
# Leave SMTP_HOST empty to skip sending: the account is still created and the generated password is
# displayed on screen for Admin/HR to copy manually (Fallback mechanism).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SkillSprint AI
# Base of the links in invitation emails, without a trailing slash
FRONTEND_URL=http://localhost:3000

