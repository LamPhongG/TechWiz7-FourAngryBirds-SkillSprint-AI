# Copy thành frontend/.env.local (đã nằm trong .gitignore)

# URL backend FastAPI, gồm cả tiền tố /api (ví dụ http://localhost:8000/api).
# Bỏ trống: tài liệu được trích xuất và chia chunk ngay trong trình duyệt.
VITE_API_URL=

# Phiên bản prompt hiển thị trên các lần chạy khi chưa có backend (backend trả về thì dùng giá trị của backend)
VITE_PROMPT_VERSION=v1.1
